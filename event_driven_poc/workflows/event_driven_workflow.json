{
  "name": "event_driven_workflow",
  "description": "Event-driven workflow that triggers microservices via Kafka",
  "version": 3,
  "tasks": [
    {
      "name": "email_validation_task",
      "taskReferenceName": "email_validation_task",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": "Email validation task started - workflow: ${workflow.workflowId}, task: ${email_validation_task.taskId}",
          "key": "email-validation-${workflow.instanceId}"
        }
      }
    },
    {
      "name": "phone_validation_task",
      "taskReferenceName": "phone_validation_task",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": "Phone validation task started - workflow: ${workflow.workflowId}, task: ${phone_validation_task.taskId}",
          "key": "phone-validation-${workflow.instanceId}"
        }
      }
    },
    {
      "name": "enrichment_task",
      "taskReferenceName": "enrichment_task",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": "Enrichment task started - workflow: ${workflow.workflowId}, task: ${enrichment_task.taskId}",
          "key": "enrichment-${workflow.instanceId}"
        }
      }
    }
  ],
  "inputParameters": [],
  "outputParameters": {
    "email_result": "${email_validation_task.output}",
    "phone_result": "${phone_validation_task.output}",
    "enrichment_result": "${enrichment_task.output}"
  },
  "schemaVersion": 2,
  "restartable": true,
  "workflowStatusListenerEnabled": false,
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 0
}

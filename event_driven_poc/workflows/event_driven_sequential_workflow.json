{
  "name": "event_driven_sequential_workflow",
  "description": "Event-driven sequential pipeline using EVENT tasks to wait for microservice completion",
  "version": 1,
  "tasks": [
    {
      "name": "start_pipeline",
      "taskReferenceName": "start_pipeline",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": "{\"workflowId\": \"${workflow.workflowId}\", \"eventType\": \"pipeline_started\", \"data\": {\"inputData\": \"${workflow.input.rawData}\", \"records\": 100, \"pipelineStage\": \"start\"}}",
          "key": "pipeline-start-${workflow.instanceId}"
        }
      }
    },
    {
      "name": "wait_for_email_completion",
      "taskReferenceName": "wait_for_email_completion",
      "type": "EVENT",
      "sink": "conductor:email_validation_completed"
    },
    {
      "name": "trigger_phone_validation",
      "taskReferenceName": "trigger_phone_validation",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": "{\"workflowId\": \"${workflow.workflowId}\", \"eventType\": \"phone_validation_requested\", \"data\": {\"inputData\": \"email_validated_data\", \"records\": 95, \"pipelineStage\": \"phone_validation\", \"previousStage\": \"email_validation\"}}",
          "key": "phone-validation-${workflow.instanceId}"
        }
      }
    },
    {
      "name": "wait_for_phone_completion",
      "taskReferenceName": "wait_for_phone_completion",
      "type": "EVENT",
      "sink": "conductor:phone_validation_completed"
    },
    {
      "name": "trigger_enrichment",
      "taskReferenceName": "trigger_enrichment",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": "{\"workflowId\": \"${workflow.workflowId}\", \"eventType\": \"enrichment_requested\", \"data\": {\"inputData\": \"phone_validated_data\", \"records\": 90, \"pipelineStage\": \"enrichment\", \"previousStage\": \"phone_validation\"}}",
          "key": "enrichment-${workflow.instanceId}"
        }
      }
    },
    {
      "name": "wait_for_enrichment_completion",
      "taskReferenceName": "wait_for_enrichment_completion",
      "type": "EVENT",
      "sink": "conductor:enrichment_completed"
    },
    {
      "name": "finalize_pipeline",
      "taskReferenceName": "finalize_pipeline",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": "{\"workflowId\": \"${workflow.workflowId}\", \"eventType\": \"pipeline_completed\", \"data\": {\"finalData\": \"enriched_data\", \"records\": 90, \"pipelineStage\": \"completed\"}}",
          "key": "pipeline-complete-${workflow.instanceId}"
        }
      }
    }
  ],
  "inputParameters": [],
  "outputParameters": {
    "pipeline_result": "${finalize_pipeline.output}",
    "workflow_id": "${workflow.workflowId}",
    "email_result": "${wait_for_email_completion.output}",
    "phone_result": "${wait_for_phone_completion.output}",
    "enrichment_result": "${wait_for_enrichment_completion.output}"
  },
  "schemaVersion": 2,
  "restartable": true,
  "workflowStatusListenerEnabled": false,
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 300
}

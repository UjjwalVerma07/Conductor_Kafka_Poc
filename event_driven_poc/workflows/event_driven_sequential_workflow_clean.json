{
  "name": "event_driven_sequential_workflow_clean",
  "description": "Clean version of event-driven sequential pipeline using MinIO file processing",
  "version": 1,
  "tasks": [
    {
      "name": "start_pipeline",
      "taskReferenceName": "start_pipeline",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": {
            "workflowId": "${workflow.workflowId}",
            "eventType": "pipeline_started",
            "data": {
              "input_bucket": "raw-data",
              "input_key": "${workflow.input.input_file}",
              "output_bucket": "email-validated",
              "output_key": "email_validated_${workflow.instanceId}.csv",
              "pipelineStage": "start",
              "records": 1000
            }
          },
          "key": "pipeline-start-${workflow.instanceId}"
        }
      }
    },
    {
      "name": "wait_for_email_completion",
      "taskReferenceName": "wait_for_email_completion",
      "type": "EVENT",
      "sink": "conductor:email_validation_completed"
    },
    {
      "name": "trigger_phone_validation",
      "taskReferenceName": "trigger_phone_validation",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": {
            "workflowId": "${workflow.workflowId}",
            "eventType": "phone_validation_requested",
            "data": {
              "input_bucket": "email-validated",
              "input_key": "email_validated_${workflow.instanceId}.csv",
              "output_bucket": "phone-validated",
              "output_key": "phone_validated_${workflow.instanceId}.csv",
              "pipelineStage": "phone_validation",
              "previousStage": "email_validation"
            }
          },
          "key": "phone-validation-${workflow.instanceId}"
        }
      }
    },
    {
      "name": "wait_for_phone_completion",
      "taskReferenceName": "wait_for_phone_completion",
      "type": "EVENT",
      "sink": "conductor:phone_validation_completed"
    },
    {
      "name": "trigger_enrichment",
      "taskReferenceName": "trigger_enrichment",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": {
            "workflowId": "${workflow.workflowId}",
            "eventType": "enrichment_requested",
            "data": {
              "input_bucket": "phone-validated",
              "input_key": "phone_validated_${workflow.instanceId}.csv",
              "output_bucket": "enriched",
              "output_key": "enriched_${workflow.instanceId}.csv",
              "pipelineStage": "enrichment",
              "previousStage": "phone_validation"
            }
          },
          "key": "enrichment-${workflow.instanceId}"
        }
      }
    },
    {
      "name": "wait_for_enrichment_completion",
      "taskReferenceName": "wait_for_enrichment_completion",
      "type": "EVENT",
      "sink": "conductor:enrichment_completed"
    },
    {
      "name": "finalize_pipeline",
      "taskReferenceName": "finalize_pipeline",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": {
            "workflowId": "${workflow.workflowId}",
            "eventType": "pipeline_completed",
            "data": {
              "final_bucket": "enriched",
              "final_key": "enriched_${workflow.instanceId}.csv",
              "pipelineStage": "completed",
              "records": 1000
            }
          },
          "key": "pipeline-complete-${workflow.instanceId}"
        }
      }
    }
  ],
  "inputParameters": [
    {
      "name": "input_file",
      "description": "Input CSV file name in raw-data bucket",
      "type": "STRING",
      "required": true
    }
  ],
  "outputParameters": {
    "pipeline_result": "${finalize_pipeline.output}",
    "workflow_id": "${workflow.workflowId}",
    "email_result": "${wait_for_email_completion.output}",
    "phone_result": "${wait_for_phone_completion.output}",
    "enrichment_result": "${wait_for_enrichment_completion.output}",
    "final_file": "enriched_${workflow.instanceId}.csv"
  },
  "schemaVersion": 2,
  "restartable": true,
  "workflowStatusListenerEnabled": false,
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 600
}

{
  "name": "kafka_event_workflow",
  "description": "Event-driven workflow using Kafka EVENT task types",
  "version": 1,
  "tasks": [
    {
      "name": "publish_email_validation_event",
      "taskReferenceName": "publish_validation_event_ref",
      "inputParameters": {
        "email": "${workflow.input.email}",
        "event_type": "EMAIL_VALIDATION_REQUESTED"
      },
      "type": "EVENT",
      "sink": "kafka:email_validation_events"
    },
    {
      "name": "validate_email",
      "taskReferenceName": "validate_email_ref",
      "inputParameters": {
        "email": "${workflow.input.email}"
      },
      "type": "SIMPLE",
      "startDelay": 0,
      "optional": false
    },
    {
      "name": "publish_enrichment_event",
      "taskReferenceName": "publish_enrichment_event_ref",
      "inputParameters": {
        "email": "${validate_email_ref.output.email}",
        "is_valid": "${validate_email_ref.output.is_valid}",
        "event_type": "DATA_ENRICHMENT_REQUESTED"
      },
      "type": "EVENT",
      "sink": "kafka:data_enrichment_events"
    },
    {
      "name": "enrich_data",
      "taskReferenceName": "enrich_data_ref",
      "inputParameters": {
        "email": "${validate_email_ref.output.email}",
        "is_valid": "${validate_email_ref.output.is_valid}",
        "validation_time": "${validate_email_ref.output.validation_time}"
      },
      "type": "SIMPLE",
      "startDelay": 0,
      "optional": false
    },
    {
      "name": "publish_completion_event",
      "taskReferenceName": "publish_completion_event_ref",
      "inputParameters": {
        "email": "${enrich_data_ref.output.email}",
        "is_valid": "${enrich_data_ref.output.is_valid}",
        "domain": "${enrich_data_ref.output.domain}",
        "enrichment": "${enrich_data_ref.output.enrichment}",
        "event_type": "WORKFLOW_COMPLETED"
      },
      "type": "EVENT",
      "sink": "kafka:workflow_completion_events"
    }
  ],
  "outputParameters": {
    "email": "${enrich_data_ref.output.email}",
    "is_valid": "${enrich_data_ref.output.is_valid}",
    "domain": "${enrich_data_ref.output.domain}",
    "enrichment": "${enrich_data_ref.output.enrichment}",
    "workflow_completed_at": "${workflow.endTime}"
  },
  "schemaVersion": 2,
  "restartable": true,
  "ownerEmail": "team@example.com",
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 600
}


{
  "name": "pure_kafka_event_workflow",
  "description": "Pure event-driven workflow - publishes events to Kafka topics",
  "version": 1,
  "tasks": [
    {
      "name": "kafka_event_start",
      "taskReferenceName": "kafka_event_start_ref",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor.email.validation.requests",
          "key": "${workflow.input.email}",
          "value": {
            "workflowId": "${workflow.workflowId}",
            "email": "${workflow.input.email}",
            "timestamp": "${workflow.startTime}",
            "requestedBy": "conductor_workflow"
          }
        }
      },
      "type": "EVENT",
      "sink": "kafka"
    },
    {
      "name": "wait_for_validation",
      "taskReferenceName": "wait_for_validation_ref",
      "inputParameters": {},
      "type": "WAIT",
      "startDelay": 0
    },
    {
      "name": "kafka_event_enrichment",
      "taskReferenceName": "kafka_event_enrichment_ref",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor.data.enrichment.requests",
          "key": "${workflow.input.email}",
          "value": {
            "workflowId": "${workflow.workflowId}",
            "email": "${workflow.input.email}",
            "timestamp": "${workflow.startTime}"
          }
        }
      },
      "type": "EVENT",
      "sink": "kafka"
    },
    {
      "name": "kafka_event_complete",
      "taskReferenceName": "kafka_event_complete_ref",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor.workflow.completed",
          "key": "${workflow.workflowId}",
          "value": {
            "workflowId": "${workflow.workflowId}",
            "status": "COMPLETED",
            "email": "${workflow.input.email}",
            "completedAt": "${workflow.endTime}"
          }
        }
      },
      "type": "EVENT",
      "sink": "kafka"
    }
  ],
  "outputParameters": {
    "workflowId": "${workflow.workflowId}",
    "email": "${workflow.input.email}",
    "events_published": 3
  },
  "schemaVersion": 2,
  "restartable": true,
  "ownerEmail": "team@example.com",
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 600
}

